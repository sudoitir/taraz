<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.sudoitir</groupId>
    <artifactId>taraz</artifactId>
    <version>${revision}</version>
  </parent>

  <artifactId>container</artifactId>
  <name>taraz-container</name>
  <description>Composition root: Spring Boot application, configuration, Liquibase migrations (ADR-0006)</description>

  <dependencies>
    <!-- Composition root wires the whole application: write side, read side, all adapters (ADR-0006) -->
    <dependency>
      <groupId>io.github.sudoitir</groupId>
      <artifactId>service</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.sudoitir</groupId>
      <artifactId>query</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.sudoitir</groupId>
      <artifactId>rest</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.sudoitir</groupId>
      <artifactId>persistence</artifactId>
    </dependency>
    <dependency>
      <groupId>io.github.sudoitir</groupId>
      <artifactId>messaging</artifactId>
    </dependency>

    <!-- CommandValidator (core/application/service) needs jakarta.validation.Validator autoconfigured.
         Declared directly rather than relying on the transitive from `rest`, so a future decoupling
         of the REST adapter cannot silently break every write-side command handler at startup. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>
    <!-- Boot 4's modularized autoconfigure: liquibase-core alone is just the library — this is what
         actually wires the SpringLiquibase bean that runs migrations at startup. Its absence was a
         real, silent gap: the application never ran any migration through the Spring-managed path
         (only Testcontainers-direct tests exercised Liquibase at all) — found while wiring the
         outbox scheduler's startup-ordering dependency on it. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
    </dependency>
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- Dev-time: boots compose.yaml services and wires their connection details (ADR-0025) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-docker-compose</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @ServiceConnection auto-wiring for Testcontainers (ADR-0053) -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers-kafka</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- No org.testcontainers:testcontainers-valkey/-redis module exists in the 2.0.5 BOM; com.redis's
         module is the one Boot 4.1 manages and its RedisContainer is @ServiceConnection-recognized. -->
    <dependency>
      <groupId>com.redis</groupId>
      <artifactId>testcontainers-redis</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.kafka</groupId>
      <artifactId>spring-kafka-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <!-- Replaces the parent's annotationProcessorPaths (Maven does not merge),
           so Error Prone + NullAway are re-included here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>com.google.errorprone</groupId>
              <artifactId>error_prone_core</artifactId>
              <version>${errorprone.version}</version>
            </path>
            <path>
              <groupId>com.uber.nullaway</groupId>
              <artifactId>nullaway</artifactId>
              <version>${nullaway.version}</version>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
              <version>${lombok.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
