# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Image versions
POSTGRES_VERSION=18
VALKEY_VERSION=9
KAFKA_VERSION=4.3.1

# PostgreSQL (system of record)
POSTGRES_DB=taraz
POSTGRES_USER=taraz
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Application datasource (container/application.yaml reads these)
DB_URL=jdbc:postgresql://localhost:5432/taraz
DB_USERNAME=taraz
DB_PASSWORD=change-me

# Valkey (cache + idempotency)
VALKEY_PORT=6379

# Application Valkey connection (application.yaml reads these)
VALKEY_HOST=localhost
VALKEY_PASSWORD=change-me

# Kafka (outbox events)
KAFKA_PORT=9092

# Application HTTP port
SERVER_PORT=8080
